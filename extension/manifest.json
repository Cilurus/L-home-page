{
  "manifest_version": 3,
  "name": "L 起始页 · DeepSeek",
  "version": "3.0.0",
  "description": "把 L 起始页覆盖到 DeepSeek 网页：时钟、搜索、壁纸、收藏一屏搞定，点鲸鱼随时切回原页面。",
  "homepage_url": "https://github.com/Cilurus/L-home-page",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content/startpage-data.js", "content/shell.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
